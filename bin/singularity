#!/usr/bin/env bash
set -euo pipefail

FM_EXPERIMENT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${1:-}" == "exec" ]]; then
  shift
  FM_RIPGREP_BIN="$(command -v rg || true)"
  if [[ -z "${FM_RIPGREP_BIN}" || ! -x "${FM_RIPGREP_BIN}" ]]; then
    echo "Host ripgrep is required for offline OpenCode search tools" >&2
    exit 2
  fi
  FM_UV_ROOT="${FM_EXPERIMENT_ROOT}/runtime/uv"
  FM_HARBOR_WHEELHOUSE="${FM_EXPERIMENT_ROOT}/runtime/harbor-server-wheelhouse"
  FM_OPENHANDS_VENV="${FM_OPENHANDS_VENV:-${FM_EXPERIMENT_ROOT}/runtime/openhands-sdk-venv}"
  FM_BIND_ARGS=()
  FM_BIND_ARGS+=(--bind "${FM_RIPGREP_BIN}:/usr/local/bin/rg:ro")
  if [[ -x "${FM_OPENHANDS_VENV}/bin/python" ]]; then
    # Harbor's OpenHands adapter installs Python/SDK dependencies at this exact
    # path. Bind the host-staged venv read-only so task-container DNS is not
    # needed and the existing task image remains unchanged.
    FM_BIND_ARGS+=(--bind "${FM_OPENHANDS_VENV}:/opt/openhands-sdk-venv:ro")
  fi
  # Pytest 9's default /tmp/pytest-of-agent ownership check fails inside
  # Apptainer's root-mapped fakeroot namespace. Keep the official verifier
  # untouched; a scoped sitecustomize hook appends --basetemp to the verifier's
  # PYTEST_ADDOPTS, using its existing agent-owned report directory.
  FM_CATTRS_VERIFIER=0
  for FM_ARG in "$@"; do
    if [[ "${FM_ARG##*/}" == "frontier-memory-cattrs-verifier.sif" ]]; then
      FM_CATTRS_VERIFIER=1
      break
    fi
  done
  if [[ "${FM_CATTRS_VERIFIER}" == "1" ]]; then
    FM_PYTEST_HOOK="${FM_EXPERIMENT_ROOT}/scripts/cattrs-verifier-sitecustomize.py"
    if [[ ! -f "${FM_PYTEST_HOOK}" ]]; then
      echo "Missing cattrs verifier pytest hook: ${FM_PYTEST_HOOK}" >&2
      exit 2
    fi
    FM_BIND_ARGS+=(--bind "${FM_PYTEST_HOOK}:/usr/local/lib/python3.12/site-packages/sitecustomize.py:ro")
  fi
  FM_PIP_ARGS=()
  if [[ -d "${FM_HARBOR_WHEELHOUSE}" ]]; then
    FM_BIND_ARGS+=(--bind "${FM_HARBOR_WHEELHOUSE}:/tmp/fm-harbor-wheelhouse:ro")
    FM_PIP_ARGS+=(
      --env PIP_FIND_LINKS=/tmp/fm-harbor-wheelhouse
      --env PIP_NO_INDEX=1
    )
  fi
  if [[ "${FM_BIND_EVIDENCE_SUMMARY:-0}" == "1" ]]; then
    FM_EVIDENCE_SUMMARY="${FM_EXPERIMENT_ROOT}/data/evidence-summary.md"
    [[ -s "${FM_EVIDENCE_SUMMARY}" ]] || {
      echo "Missing compact corpus evidence: ${FM_EVIDENCE_SUMMARY}" >&2
      exit 2
    }
    FM_BIND_ARGS+=(--bind "${FM_EVIDENCE_SUMMARY}:/tmp/frontiermemory-corpus-summary.md:ro")
  fi
  exec apptainer exec \
    "${FM_BIND_ARGS[@]}" \
    "${FM_PIP_ARGS[@]}" \
    --bind "${FM_UV_ROOT}:${FM_UV_ROOT}:rw" \
    --env PATH="${FM_UV_ROOT}/bin:${FM_UV_ROOT}/tool-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    --env UV_CACHE_DIR="${FM_UV_ROOT}/cache" \
    --env UV_PYTHON_INSTALL_DIR="${FM_UV_ROOT}/python" \
    --env UV_TOOL_DIR="${FM_UV_ROOT}/tools" \
    --env UV_TOOL_BIN_DIR="${FM_UV_ROOT}/tool-bin" \
    --env UV_PYTHON_BIN_DIR="${FM_UV_ROOT}/bin" \
    --env UV_OFFLINE=true \
    --env XDG_CONFIG_HOME=/tmp/frontiermemory-agent-config \
    --env XDG_CACHE_HOME=/tmp/frontiermemory-agent-cache \
    --env XDG_DATA_HOME=/tmp/frontiermemory-agent-data \
    --env MSWEA_GLOBAL_CONFIG_DIR=/tmp/frontiermemory-agent-config/mswe \
    --env MSWEA_SILENT_STARTUP=1 \
    "$@"
fi

exec apptainer "$@"
