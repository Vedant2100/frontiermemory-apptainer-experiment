Bootstrap: localimage
From: /home/csgrad/vbork001/frontiermemory-experiment-20261024/containers/frontier-memory-cattrs.sif

%files
    /home/csgrad/vbork001/frontiermemory-experiment-20261024/data/tasks/frontier-memory/cattrs-compositional-changelog/tests /tests

%post
    set -eu
    test -f /tests/test.sh
    chmod +x /tests/test.sh
    grep -q '^agent:' /etc/passwd || printf '%s\n' 'agent:x:10001:10001:Harbor agent:/home/agent:/bin/sh' >> /etc/passwd
    grep -q '^agent:' /etc/group || printf '%s\n' 'agent:x:10001:' >> /etc/group
    mkdir -p /home/agent
    chown 10001:10001 /home/agent
    mkdir -p /logs/verifier
    chmod 700 /logs/verifier
