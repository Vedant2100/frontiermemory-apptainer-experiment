Bootstrap: docker
From: public.ecr.aws/d3j8x8q7/swe-bench-202605@sha256:c574abfc7049c710e7ab94b53829e21ed3a89544a2e04389fe7f4b01e4c6002e

%files
    /home/csgrad/vbork001/frontiermemory-experiment-20261024/data/tasks/frontier-memory/awilix-release-tier-implicit/tests/original-test.sh /tests/original-test.sh
    /home/csgrad/vbork001/frontiermemory-experiment-20261024/data/tasks/frontier-memory/awilix-release-tier-implicit/tests/test.sh /tests/test.sh
    /home/csgrad/vbork001/frontiermemory-experiment-20261024/data/tasks/frontier-memory/awilix-release-tier-implicit/tests/copy_agent_reports.py /tests/copy_agent_reports.py
    /home/csgrad/vbork001/frontiermemory-experiment-20261024/data/tasks/frontier-memory/awilix-release-tier-implicit/tests/test.patch /tests/test.patch
    /home/csgrad/vbork001/frontiermemory-experiment-20261024/data/tasks/frontier-memory/awilix-release-tier-implicit/tests/user_preference_verifier.py /tests/user_preference_verifier.py
    /home/csgrad/vbork001/frontiermemory-experiment-20261024/data/tasks/frontier-memory/awilix-release-tier-implicit/tests/user-preference.json /tests/user-preference.json

%post
    set -eu
    python3 -m venv /opt/harbor-server
    /opt/harbor-server/bin/python3 -m pip install --no-cache-dir fastapi==0.162.0 uvicorn==0.54.0
    chmod +x /tests/test.sh /tests/original-test.sh
    if ! command -v runuser >/dev/null 2>&1; then \
      if command -v apt-get >/dev/null 2>&1; then apt-get update && apt-get install -y --no-install-recommends passwd util-linux && rm -rf /var/lib/apt/lists/*; \
      elif command -v apk >/dev/null 2>&1; then apk add --no-cache shadow util-linux; \
      else echo 'unsupported verifier base image: runuser is required' >&2; exit 1; fi; \
    fi
    id -u agent >/dev/null 2>&1 || useradd --create-home --uid 10001 agent
    chmod 755 /tests /tests/test.sh
    mkdir -p /logs/verifier
    chmod 700 /logs/verifier
