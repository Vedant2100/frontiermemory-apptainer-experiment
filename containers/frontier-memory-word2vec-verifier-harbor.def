Bootstrap: localimage
From: /home/csgrad/vbork001/frontiermemory-experiment-20261024/containers/frontier-memory-word2vec-verifier.sif

%setup
    mkdir -p "${APPTAINER_ROOTFS}/tests"

%files
    /home/csgrad/vbork001/frontiermemory-experiment-20261024/data/tasks/frontier-memory/build-word2vec-pipeline/tests/test.sh /tests/test.sh
    /home/csgrad/vbork001/frontiermemory-experiment-20261024/data/tasks/frontier-memory/build-word2vec-pipeline/tests/test_outputs.py /tests/test_outputs.py

%post
    chmod 755 /tests /tests/test.sh
    ln -s /usr/local/bin/python3 /usr/bin/python3

%environment
    export PYTHONPATH="/workspace:${PYTHONPATH:-}"
    export PYTHONUNBUFFERED=1

%runscript
    exec /bin/bash "$@"
